<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx"

           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="org.example.controller.LoginController"
           prefHeight="600.0" prefWidth="900.0"
           styleClass="fondo">


    <VBox alignment="CENTER" spacing="16" styleClass="caja-login" maxWidth="340">
        <padding>
            <Insets top="50" right="35" bottom="50" left="35"/>
        </padding>

        <Label text="MultiSports" styleClass="titulo"/>
        <Region prefHeight="25"/>

        <VBox spacing="8" prefWidth="310">
            <Label text="Email" styleClass="etiqueta"/>
            <TextField fx:id="txtEmail"
                       promptText="tu@email.com"
                       styleClass="campo"/>
        </VBox>

        <VBox spacing="8" prefWidth="280">
            <Label text="Contraseña" styleClass="etiqueta"/>
            <PasswordField fx:id="txtPassword"
                           promptText="Ingresa tu contraseña"
                           styleClass="campo"
                           text=""/>
        </VBox>

        <Label fx:id="lblMensaje" styleClass="mensaje" text=""/>

        <Button text="Iniciar Sesión"
                onAction="#onLogin"
                styleClass="boton-login"
                prefWidth="310"
                defaultButton="true"/>

        <Region prefHeight="8"/>

        <Button text="Registrarse"
                onAction="#onRegistro"
                styleClass="boton-registro"
                prefWidth="330"/>

    </VBox>

</StackPane>
