<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/17.0.12"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="org.example.controller.HomeController"
           prefHeight="600.0" prefWidth="900.0"
           styleClass="fondo">


    <VBox alignment="CENTER" spacing="25" styleClass="caja-login" maxWidth="450">
        <padding>
            <Insets top="45" right="45" bottom="45" left="45"/>
        </padding>


        <Label text="¡Bienvenido/a!" styleClass="titulo"/>
        <Label fx:id="lblNombreUsuario"
               text="Usuario"
               style="-fx-font-family: 'Poppins', 'Segoe UI', Arial, sans-serif; -fx-font-size: 24px; -fx-text-fill: #60a5fa; -fx-font-weight: 600;"/>
        <Region prefHeight="20"/>

        <Label text="Has iniciado sesión correctamente en MultiSports"
               style="-fx-font-family: 'Poppins', 'Segoe UI', Arial, sans-serif; -fx-font-size: 14px; -fx-text-fill: #cbd5e1; -fx-text-alignment: center;"
               wrapText="true"/>

        <Region prefHeight="15"/>

        <Button text="Cerrar Sesión"
                onAction="#onCerrarSesion"
                styleClass="boton-registro"
                prefWidth="280"/>


    </VBox>

</StackPane>